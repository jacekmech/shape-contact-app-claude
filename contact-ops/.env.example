# Message returned by GET /api/hello
# Default: 'Hello, World!' — no manual setup required to run the stack locally
HELLO_MESSAGE=Hello, World!

# Email addresses used for contact form delivery
# SMTP connection is hardcoded in docker-compose.yml to use the internal
# contact-mailhog service — no SMTP vars need to be set for local development
EMAIL_FROM=contact@localhost
EMAIL_TO=owner@localhost
