# Message returned by GET /api/hello and displayed on the frontend.
# Copy this file to .env and adjust values for local development.
HELLO_MESSAGE=Hello, world!

# Email transport: "console" (default, logs to stdout), "file" (logs to EMAIL_LOG_FILE), or "smtp".
EMAIL_TRANSPORT=console

# Recipient and sender addresses used for contact form submissions.
CONTACT_FROM_EMAIL=noreply@example.com
CONTACT_TO_EMAIL=owner@example.com

# SMTP settings — only required when EMAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# File path for email logs — only used when EMAIL_TRANSPORT=file.
EMAIL_LOG_FILE=
