# Message returned by GET /api/hello
# Default: 'Hello, World!'
HELLO_MESSAGE=Hello, World!

# Port the API server listens on
# Default: 3001
PORT=3001

# SMTP connection — defaults point at local Mailhog dev server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email addresses used for contact form delivery
# Default sender and recipient work out of the box with Mailhog
EMAIL_FROM=contact@localhost
EMAIL_TO=owner@localhost
