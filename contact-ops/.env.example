# Greeting message served by the hello endpoint.
# Defaults to "Hello, World!" when not set.
HELLO_MESSAGE=Hello, World!

# Email address that receives contact form submissions.
CONTACT_RECIPIENT=you@example.com

# Email transport: "console" (default, logs to stdout) or "smtp".
EMAIL_TRANSPORT=console

# SMTP settings — required when EMAIL_TRANSPORT=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
SMTP_FROM=noreply@example.com
